---
import Base from '../layouts/Base.astro';
import ArticleCards from '../components/ArticleCards.astro';
import NewsList from '../components/NewsList.astro';
import { t } from '../i18n/ui.js';
import { articles } from '../lib/articles.js';
const { lang } = Astro.props;
const s = t(lang);
const items = await articles(lang, 'lidom');
---
<Base lang={lang} path="/lidom/" title={s.winterBall}>
  <span class="kicker" style="display:block;margin-top:32px">LIDOM</span>
  <h1 class="h-page" style="margin-top:4px">{s.winterBall}</h1>
  <!-- The articles column only appears once there is at least one LIDOM article. -->
  <div class="row">
    <div class="main" style={items.length ? undefined : 'flex-basis:100%;padding-right:0'}>
      <NewsList lang={lang} team="lidom" heading={s.lidomNews} limit={30} layout="wide" />
    </div>
    {items.length > 0 && (
      <aside class="side stack">
        <h2 class="h-sec">{s.articles}</h2>
        <ArticleCards lang={lang} items={items} />
      </aside>
    )}
  </div>
</Base>
